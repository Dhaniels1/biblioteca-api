  "item": [
    {
      "name": "01 Registro",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aluno Postman\",\n  \"email\": \"{{email}}\",\n  \"password\": \"SenhaTeste123!\",\n  \"password_confirmation\": \"SenhaTeste123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"JSON\", () => pm.response.to.be.json);",
              "pm.environment.set(\"token\", pm.response.json().token);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set(\"email\", \"aluno.\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.com\");",
              "pm.environment.set(\"isbn\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        }
      ]
    },
